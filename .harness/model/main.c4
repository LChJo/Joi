views {
 view overview { include * }
 view layers of app { include app.* }
 view conversation_flow {
  include app.renderer
  include app.http
  include app.composition
  include app.application.conversations
  include app.infrastructure.conversationStorage
  include app.infrastructure.conversationStorage.piSessions
 }
 view remote_conversations {
  include app.renderer
  include app.http
  include app.mobile
  include app.native
  include app.infrastructure
  include app.composition
  include app.application.remote
  include app.application.conversations
  include app.shared
 }
}
