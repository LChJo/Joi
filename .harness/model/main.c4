specification {
 element system
 element component
 relationship calls
}
model {
 app = system "joi" {
metadata {
 harness_id "aa3360ea-59e1-4d98-8fb9-9279077683d3"
 brief "Global Joi orchestration runtime and desktop/web/Android surfaces. Onboarding review covers module responsibilities and representative entry points; it is not a full function-level audit."
 source "fact"
 status "verified"
 evidence "8cdafcd8-5645-4e29-a4e6-84a24465e383 529363b4-ba83-4f8c-946f-579a736f0406 a13847af-27a8-4200-a5ca-abad35d0456d"
 version "3"
}
desktop = component "Desktop shell" {
metadata {
 harness_id "4677d33a-a6e5-4331-8e52-1a42de40beab"
 brief "Electron lifecycle; sandboxed renderer window and worker-backed runtime composition."
 source "fact"
 status "verified"
 evidence "b4e0c245-401d-4f68-9009-f3ead2f2c98a"
 version "2"
}
}
renderer = component "Web renderer" {
metadata {
 harness_id "2d1c904d-2d74-4f20-9d7b-e4675d617cdf"
 brief "React desktop/LAN views use shared DTOs and HTTP without privileged imports. Stable tool/activity disclosures retain safe context and public thinking summaries. A themed accessible extension list controls Subagents, OpenWiki, Browser Loop and Safety Net; per-conversation drafts and turn snapshots restore selection, native partners omit Pi extensions, and settings stays last."
 source "fact"
 status "verified"
 evidence "bb0959ec-71ad-48ea-824b-3aa91a15a7a1 b4fa28c9-1351-4ac0-aa75-af6c6f4e48a9 2bee49b0-f04c-4ce2-8f64-79516009c1e9 e5ed42e2-c606-4dd6-8d01-a16986fe9ba0 4533c5a3-4aba-4fcb-bc4c-7c1f7d7d5c30 bdb1be5c-c983-4e99-8b95-e1f0df5ed37f 08e91490-c42a-42e1-a0c5-4a40c1e2fe0e e5438320-e3e9-41e2-abf9-b409867822e0 ececa617-c6a3-4ea1-a324-a7feb9d2e600 8dc57d83-a63f-4aaf-9cec-21a2a3252c29 f1700bac-e723-4de3-b839-f99c567e6d08 6097810a-ce3d-4038-9a5c-f30fc8382210 c3ae40e3-2672-4b92-b011-b2ef3c6044a8 5bc37929-aa0f-458c-98ae-57aa0ea8090e"
 version "11"
}
}
preload = component "Desktop bridge" {
metadata {
 harness_id "25af6153-5b7f-4aa4-bf33-a2320d741b72"
 brief "Frozen nonce/runtime-info bridge; business APIs stay on HTTP."
 source "fact"
 status "verified"
 evidence "cf19bd4f-253f-4a1b-b33e-81e409048150"
 version "2"
}
}
http = component "HTTP interfaces" {
metadata {
 harness_id "5619f950-f538-4420-a8e1-8e5dbe296c42"
 brief "Authenticated HTTP route mapping, CSRF/origin write verification and desktop-only conversation filesystem/Git access. Conversation archive listing and lifecycle writes map shared contracts through existing authentication and CSRF/origin guards. History/event cursors are scoped to the conversation; child cancellation uses the existing write guards."
 source "fact"
 status "verified"
 evidence "d8f1b579-a4c5-4ab4-a8df-51c8728fbc96 529363b4-ba83-4f8c-946f-579a736f0406 3a9f444d-04a7-43d1-9a57-0212eeda58ca c3ae40e3-2672-4b92-b011-b2ef3c6044a8"
 version "5"
}
}
composition = component "Runtime composition" {
metadata {
 harness_id "e6c5c10e-00a0-463c-b414-08b647077758"
 brief "Wires workers, services and adapters, independent conversation turns and coordinated Git delivery. Graceful shutdown closes delivery before aborting engines and preserves unstarted conversation messages; explicit emergency stop cancels them. A separate child dispatcher allows parent settlement without blocking child delivery."
 source "fact"
 status "verified"
 evidence "6c84adef-da3b-49e2-8c3c-3162e41cb524 8d9826b0-5e9d-43c8-b4c4-5e247ac56d15 aeb013b6-fda3-401d-88ca-e6464dcd5bba 0928551c-008e-4486-b324-fdd3cc15e717 313dd958-6c17-4b51-8f69-c45004e29137 c3ae40e3-2672-4b92-b011-b2ef3c6044a8"
 version "5"
}
}
application = component "Application services" {
metadata {
 harness_id "3c08dc1c-527b-456b-999b-8982b0ada159"
 brief "Orchestrates inbox, goals, work, automation and learning. User-driven conversations retain single-turn exclusion and checkpointed tool permissions but acquire no autonomous workspace lease. Conversation lifecycle actions start no execution; explicit Git mutations retain repository admission. Safe native-tool lifecycle facts survive normalization into conversation entries. Conversation execution also owns canonical private sessions and child lifecycle; autonomous scheduling remains separate. Conversation-only activity merges with streamed/final snapshots and is retained through terminal failures; pending projection writes drain before completion. Work event kinds remain unchanged."
 source "fact"
 status "verified"
 evidence "ab916d87-3ab3-4619-9f69-ce1f640aae6d a984c882-2ef4-40fc-a9a5-dca9f6ce824e 02183363-905c-43b4-9579-4b7dd225d966 8d9826b0-5e9d-43c8-b4c4-5e247ac56d15 529363b4-ba83-4f8c-946f-579a736f0406 d07c943c-dd56-49b1-8fad-3ad61f4df6cc 313dd958-6c17-4b51-8f69-c45004e29137 c3ae40e3-2672-4b92-b011-b2ef3c6044a8 b2a4acb0-0d03-490d-8118-9f905e528312"
 version "8"
}
conversations = component "Conversation execution" {
metadata {
 harness_id "cad6c097-c1e0-468e-9195-6e4005ccec71"
 brief "User-driven turn/session orchestration preserves workbench ownership, private history, safe activity and durable children. Static extension selections are validated, normalized into retry identity, stored in turn JSON and forwarded across READ/WRITE admission; native partner requests reject Pi extensions."
 source "fact"
 status "verified"
 evidence "d07c943c-dd56-49b1-8fad-3ad61f4df6cc 313dd958-6c17-4b51-8f69-c45004e29137 c3ae40e3-2672-4b92-b011-b2ef3c6044a8 b2a4acb0-0d03-490d-8118-9f905e528312"
 version "5"
}
}
}
domain = component "Domain policies" {
metadata {
 harness_id "b48eb196-1e32-4244-9cb1-070336a79f17"
 brief "Pure TypeScript admission and validation. Explicit Wiki retrieval is READ; Wiki run mutations and every potentially provisioning cloud browser tool require WRITE. Unknown extension tool names remain denied; custom partner minimum access reflects those effects."
 source "fact"
 status "verified"
 evidence "246218d7-0c42-468a-b979-615c8ca1525d 2bee49b0-f04c-4ce2-8f64-79516009c1e9 c3ae40e3-2672-4b92-b011-b2ef3c6044a8 d6797abc-d945-4aa6-bc1a-49d0558529bc"
 version "4"
}
}
infrastructure = component "Infrastructure adapters" {
metadata {
 harness_id "05a7cbd5-4101-4522-a77a-16d3914b08c8"
 brief "Implements persistence, engine, A2A, security and artifact ports. Conversation state is transactional; startup clears backoff only for unstarted queued turns, preserving interrupted-execution protection and stable identities. Explicit Git uses root-confined file adapters and repository coordination. Pinned SDK sessions, native journals and incremental conversation/child stores implement the new ports."
 source "fact"
 status "verified"
 evidence "6c84adef-da3b-49e2-8c3c-3162e41cb524 8d9826b0-5e9d-43c8-b4c4-5e247ac56d15 aeb013b6-fda3-401d-88ca-e6464dcd5bba 529363b4-ba83-4f8c-946f-579a736f0406 db8263f3-5e65-499b-b358-e54b40a000cd 1cb47532-3623-40ae-88b1-bd52b81947e5 b19e6407-d990-45b3-b75e-b5ba562fd399 54304c25-7793-4c5a-b601-f649f10df3f1 629887d6-ca08-4e3b-9116-9def218c167e 90a83f7c-9a38-475a-a9ec-49d540abde2d 1519c446-98f9-4b5a-b873-26ea5d8e7d89"
 version "6"
}
conversationStorage = component "Conversation persistence" {
metadata {
 harness_id "882f7b90-4074-4541-bcad-2c7a7ea4b7cb"
 brief "Private incremental source messages and checkpoints, frozen child/outbox intents, safe history pages and update cursors."
 source "fact"
 status "verified"
 evidence "db8263f3-5e65-499b-b358-e54b40a000cd 1519c446-98f9-4b5a-b873-26ea5d8e7d89 c3ae40e3-2672-4b92-b011-b2ef3c6044a8"
 version "1"
}
piSessions = component "Pi context and execution" {
metadata {
 harness_id "c12f9eba-5f56-4fa1-b864-025e3193a7c3"
 brief "Pinned Pi 1.5.2 sessions reuse Joi context, journals and permission gates. Optional host adapters expose OpenWiki 0.9.0 protocol tools, Browser Loop 0.12.1 function tools and Safety Net 2.7.11 evaluation; ambient SDK discovery and nested extension execution stay disabled. Wiki roots bind to workbenches; billable browsers require WRITE and settle cleanup even after child or journal failure. Codemode/MCP remain research candidates."
 source "fact"
 status "verified"
 evidence "54304c25-7793-4c5a-b601-f649f10df3f1 629887d6-ca08-4e3b-9116-9def218c167e 90a83f7c-9a38-475a-a9ec-49d540abde2d c3ae40e3-2672-4b92-b011-b2ef3c6044a8 dae0093b-300e-4129-8563-fa0ff2ad9f33 793588d4-9226-45ea-bcb5-58e60334355c 68c4824e-2fab-4811-8c3b-de40278beff1 5841bbad-682d-467a-95f9-8acd70e76c32 e06f4768-44ed-4bb9-8347-bba17ca19cbd 217abdfa-12d5-417d-8e0b-7e55f72917f6 d6797abc-d945-4aa6-bc1a-49d0558529bc 2554deb1-dde9-4858-bb55-e867f1d4d116 8c586b5a-6dfe-43c0-9e0f-8cd885e73a12 5bc37929-aa0f-458c-98ae-57aa0ea8090e"
 version "3"
}
}
}
}
shared = component "Shared contracts" {
metadata {
 harness_id "523ea4b5-9b46-4d67-be22-b9ee3d7d3cfb"
 brief "Shared contracts carry safe conversation activity, history pages and scoped child/cursor metadata. Optional static Pi extension ID arrays remain compatible with existing turn JSON and are validated at application and HTTP boundaries; global Work entry enums stay unchanged."
 source "fact"
 status "verified"
 evidence "67786627-f77c-4800-9ac6-386b484e5f5d b4fa28c9-1351-4ac0-aa75-af6c6f4e48a9 24499f6b-3dfd-4a50-836f-0a7b169c1ee2 c3ae40e3-2672-4b92-b011-b2ef3c6044a8"
 version "8"
}
}
