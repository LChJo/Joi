model {
 app = system "joi" {
metadata {
 harness_id "aa3360ea-59e1-4d98-8fb9-9279077683d3"
 brief "Global Joi orchestration runtime and desktop/web/Android surfaces. Onboarding review covers module responsibilities and representative entry points; it is not a full function-level audit."
 source "fact"
 status "verified"
 evidence "8cdafcd8-5645-4e29-a4e6-84a24465e383 529363b4-ba83-4f8c-946f-579a736f0406 a13847af-27a8-4200-a5ca-abad35d0456d"
 version "3"
}
desktop = component "Desktop shell" {
metadata {
 harness_id "4677d33a-a6e5-4331-8e52-1a42de40beab"
 brief "Electron lifecycle; sandboxed renderer window and worker-backed runtime composition."
 source "fact"
 status "verified"
 evidence "b4e0c245-401d-4f68-9009-f3ead2f2c98a"
 version "2"
}
}
renderer = component "Web renderer" {
metadata {
 harness_id "2d1c904d-2d74-4f20-9d7b-e4675d617cdf"
 brief "React views use shared DTOs and HTTP. User message bubbles fit their content, stay right-aligned and wrap within responsive maximum widths. Reply copy controls center both copy and success glyphs within explicit button dimensions. Each turn projects only its last thinking phase into stable tool disclosures; expanding reveals a bounded public summary while complete execution history stays intact. The accessible extension list uses a distinct puzzle glyph and shows names and fixed-size switches for Subagents, local Agent Browser and Safety Net, without helper copy. Missing private history remains an internal marker without explanatory UI text. Drafts restore current selections; removed cloud IDs do not enable the replacement. Native partners omit Pi extensions and settings stays last. Partner tool cards use one default-off Agent Browser switch to select or clear the complete browser family while retaining independent core choices. Complete saved selections restore as on; legacy partial selections save as off without widening. Counts treat the family once, catalog failures preserve permissions, and switch geometry supports keyboard input, themes and narrow layouts. History actions offer title editing with selected input, keyboard save/cancel, pending guards and retry; saved titles update history, search and the selected header without resetting drafts. Safe current-turn SSE updates preserve loaded history, drafts and titles; generation counters reject stale refreshes, and disconnected streams fall back to 100 ms cursors. Scoped reads have timeout, cancellation, backoff and selection epochs. Successful reads and accepted stream snapshots clear only their connection notice; authentication rejection stops automatic reads and closes the stream. Model recovery and safe execution failures remain distinct. Model forms share expanded 2M/3M context and 256K/300K/512K output tiers. New connections select 1M/128K; existing recommended and custom limits survive editing. LAN browsers share conversation UI through authenticated HTTP without local workspace controls. Responsive history closes on narrow transitions. The legacy paired fallback reuses conversation and archive views through a restricted command adapter. Routine continuation editing retains its controlled goal id while pending, running or blocked runs lock target selection."
 source "fact"
 status "verified"
 evidence "bb0959ec-71ad-48ea-824b-3aa91a15a7a1 b4fa28c9-1351-4ac0-aa75-af6c6f4e48a9 2bee49b0-f04c-4ce2-8f64-79516009c1e9 e5ed42e2-c606-4dd6-8d01-a16986fe9ba0 4533c5a3-4aba-4fcb-bc4c-7c1f7d7d5c30 bdb1be5c-c983-4e99-8b95-e1f0df5ed37f 08e91490-c42a-42e1-a0c5-4a40c1e2fe0e e5438320-e3e9-41e2-abf9-b409867822e0 ececa617-c6a3-4ea1-a324-a7feb9d2e600 8dc57d83-a63f-4aaf-9cec-21a2a3252c29 f1700bac-e723-4de3-b839-f99c567e6d08 6097810a-ce3d-4038-9a5c-f30fc8382210 c3ae40e3-2672-4b92-b011-b2ef3c6044a8 5bc37929-aa0f-458c-98ae-57aa0ea8090e 2a3aff22-8581-424c-af0a-c4182b77742f 8b99a8d3-c9b5-4f56-aca5-67d33579c709 9b9178f5-d29c-46e3-be65-8f7760ea0055 c4daa482-036e-467b-849b-5c3041e5d812 a8d58319-cdbe-4c6d-ab62-1d334fa3b766 924fa695-204b-44c7-a782-358227365952 bf6ad363-5fc0-4a19-9332-de2c603b9e8c 85794627-0653-4404-bc02-7c4deb5225cd cea47700-6070-440d-8bb0-71bb202849a8 18da4429-806e-4b16-b3d4-1363a15b85aa 68e4f10a-361b-41e7-b7cd-8e3d97365210 3627078a-b447-432c-9b65-37a1521deadb 19825361-c0da-4b03-b1bb-abfe0bef46ed 0d39bd91-cffc-4674-a1da-a6e3c7d8393e a2186992-b051-47e8-bdce-a4e4d8878e40 c08040c4-15d6-410b-b52d-ca49f3aca31f"
 version "26"
}
}
