validation = component "Quality gates" {
metadata {
 harness_id "cfebb4bc-4ef2-4661-bd04-0d17d7f6619f"
 brief "Boundary scanner classifies allowed imports; npm scripts define checks and packaging. The Node 24 Windows/macOS quality matrix requires a complete shared lock graph, including optional WASM peer dependencies, before builds and tests. Isolated npm 11.19.1 lock validation supplements installed-tree checks. Two real-disk persistence scenarios have explicit bounded CI wait budgets; local budgets, transaction counts, privacy assertions and coverage gates remain enforced. Streaming regressions cover synthetic Pi callbacks, committed projections, transport cleanup, short-answer display, stale reads and an isolated Electron event stream. Renderer and disposable Electron checks verify model creation defaults, expanded limit submissions and retained saved values. Cross-platform conversation regressions cover command admission, device-scoped paging, restricted browser adapters, no-preload viewport behavior and encrypted/native widget paths. Disposable lease regressions cover waiting projections, same-identity resume and completion, canceled cards and bounded Git inspection without external commands. Local checks follow the change-scope matrix, with targeted regressions and static checks first; Electron/native verification, coverage and builds require relevant boundaries or explicit full/release scope. Passing checks and current artifacts are reused."
 source "fact"
 status "verified"
 evidence "2bee49b0-f04c-4ce2-8f64-79516009c1e9 8cdafcd8-5645-4e29-a4e6-84a24465e383 70e2a22b-f223-48ee-ad62-781b5835ed5e ee49fdc6-1c1c-48a7-a1ee-afa121d0b174 fee6a674-0e8e-490e-940d-0f2ea5ae7f8e 5bc37929-aa0f-458c-98ae-57aa0ea8090e ac69fa43-cea7-401a-a580-5f894151a348 2f959b06-4ad5-42b6-9fe0-f927d20e3e3f d3ce4801-6708-4041-a84e-7a5fa383272a 44b4de62-537a-42f1-8a5c-40d72900430b 2cf215ea-bf39-4ead-a1d5-70c2133ae170 924fa695-204b-44c7-a782-358227365952 bf6ad363-5fc0-4a19-9332-de2c603b9e8c 85794627-0653-4404-bc02-7c4deb5225cd cea47700-6070-440d-8bb0-71bb202849a8 18da4429-806e-4b16-b3d4-1363a15b85aa 68e4f10a-361b-41e7-b7cd-8e3d97365210 ffbbdd29-0a69-4db5-87ff-fcd20d74a1c2 b82fa8ff-8f0f-4ea0-ac05-b4e614fa6ee1 781c1021-b0b0-4b2f-83b1-2f8036629656 2e1b561f-9d1a-4a52-984b-ffd491ce229c 0d39bd91-cffc-4674-a1da-a6e3c7d8393e 00eddc89-bcf1-43bd-ab95-2532ceb7d32a baccc11b-b811-475c-8ccc-299ecea71659 576c8091-c165-4774-b79f-eb346bc5c9bb 54924ed6-1441-4f5d-a175-47b16eae6fbc 55d157d7-c373-46ea-a1c5-27bcacf3421c 4556eda4-7897-4b69-a74e-21bb633756c1 f36cf665-bf68-4d61-bae9-8995b49dff4b c08040c4-15d6-410b-b52d-ca49f3aca31f"
 version "11"
}
}
}
