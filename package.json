{
  "name": "joi",
  "version": "0.1.0",
  "private": true,
  "description": "joi is a persistent, event-driven digital life runtime hub for personal computers.",
  "author": "joi Contributors",
  "type": "module",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -s first \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:43715 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:43715 electron .\"",
    "start": "npm run dev",
    "app:run": "npm run build:prod && electron .",
    "assets:icons": "electron scripts/render-app-icon.cjs",
    "clean": "node scripts/clean-artifacts.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:renderer": "vitest run tests/renderer",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "npm run build:prod && playwright test",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:prod": "rimraf dist && npm run build:renderer && npm run build:electron",
    "package": "node scripts/package-app.mjs",
    "package:win": "node scripts/package-app.mjs --target win",
    "package:mac": "node scripts/package-app.mjs --target mac",
    "package:dir": "node scripts/package-app.mjs --target dir",
    "package:verify": "npm run build:prod && node scripts/package-verify.mjs",
    "check:boundaries": "node scripts/architecture-boundaries.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:coverage && npm run build:prod && npm run package:verify"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@mozilla/readability": "^0.6.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/themes": "3.3.0",
    "@rd-efficiency/agentsdk": "5.9.17",
    "decimal.js": "^10.6.0",
    "linkedom": "^0.18.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.3",
    "cross-env": "10.1.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  },
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=11.0.0"
  },
  "build": {
    "appId": "com.aimana.joi",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/@rd-efficiency/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "productName": "joi",
    "directories": {
      "output": "release-joi"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "resources/branding/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "perMachine": false
    },
    "mac": {
      "icon": "resources/branding/icon.png",
      "target": "dmg",
      "category": "public.app-category.productivity"
    }
  }
}
