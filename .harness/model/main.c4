officialRuntime = component "Official session execution" {
metadata {
 harness_id "90adf9e2-af9d-42c8-b744-7fe690236e78"
 brief "The public factory and thin partner/primary adapters assemble pinned models, explicit tools, skills and extensions. Tool adapters preserve official prompt metadata. Shared public startup prompt configuration retains custom role policy, renders active tool/rule sections, separates workbench/main-skill context, reuses official project/skill/cwd resources and refreshes local system dates without execution intervention. SDK owns requests, retries, parallel execution and compaction. Local primary question/completion declarations preserve business barriers. Primary requirements and continuation context are projected into requests. Scoped prior Turn reads resolve authoritative goal and Workbench membership before opening one execution. Settled native result markers retain distinct initial and repair identities for recovery without model replay. Conversation and child ask_user is a public sequential extension tool that awaits the durable queue and returns to the original toolCallId; SDK continuation remains in the same turn. Public RPC UI binding adapts select/input/editor/confirm without replacing Agent callbacks; explicit dialog cancellation revokes only that card and confirm defaults to denial. Successful canonical ask_user results acknowledge delivery, while basic UI answers wait for a durable execution result. Shutdown retains recoverable questions and child ownership after acknowledgement drain; user stop still revokes pending cards. Goal Work retains a structured pause result and primary user_ask delegates to the goal clarification port."
 source "fact"
 status "verified"
 evidence "629887d6-ca08-4e3b-9116-9def218c167e c0fbdf81-21b8-46b1-9b34-73d31b228a96 a0e8bc2b-c6f8-4a52-91aa-5b70f6be44a6 29e3189a-98ca-4c5f-b287-0d54ef815d40 4491a2e3-577b-4501-8471-6f2d31fb48ce 901170eb-ce8b-4885-b8ff-c0251181f29e ede12cff-e276-4394-b302-ae9908473949 1fbd5c7f-b90f-457f-a5b7-b06bdd9c349f c0c72b32-20e8-43a7-83c1-c66142ed079b 21229091-a27c-4a31-b947-2f5f5156d2d2 70712ab8-9239-417e-ae73-bc61ce09c371 793588d4-9226-45ea-bcb5-58e60334355c 60fe6b4d-06e2-46f5-8e7f-e680ff854cf9 d07c943c-dd56-49b1-8fad-3ad61f4df6cc 64c24ebe-09b2-47ab-9204-f66893cf8d48 44b4de62-537a-42f1-8a5c-40d72900430b 8a33efd3-2a5b-4155-a3ed-c814e0683844 0423a1b2-bacf-4268-aacc-a5b27b920a66 5cc8dd07-5b08-4c9e-a9da-fc71b178abaa d9162e86-f91d-4ddd-a4f4-f63f81dd2e2d"
 version "5"
}
}
nativeHistory = component "Native history and migration" {
metadata {
 harness_id "eddb5187-fe0d-460d-8c42-e4dc85e9b3f6"
 brief "Identity-derived private SDK files retain canonical entries, parent sessions and active branches. Atomic import preserves source backups and fingerprints. Source/result readers reject invalid or missing identities; SQLite projections cannot overwrite native authority. Atomic numeric cursor sidecars retain acknowledged reconciliation progress; completed unchanged histories skip full reads after a durable ledger receipt check, and independent ledger rollback invalidates newer progress."
 source "fact"
 status "verified"
 evidence "f73996f8-951b-4f7c-81c6-d7dcad8c0578 e1ca99c3-c87f-4f8b-be6a-5704c282e37b"
 version "2"
}
}
observations = component "Observation and numeric reconciliation" {
metadata {
 harness_id "90961091-4697-4436-872b-5ef0020ec29a"
 brief "Bounded queues isolate display and ordinary statistics failures. Canonical usage collectors attribute stable numeric facts and original timestamps; summary attempts and optional warming are observed without changing SDK control flow. Background sweeps retain identity-bound attribution and a contiguous acknowledged cursor across restart, skip unchanged completed histories only with a current ledger receipt, and retry unacknowledged or rolled-back facts without controlling SDK execution."
 source "fact"
 status "verified"
 evidence "a4d690cc-b3fe-4dbe-abff-251450f6d7e7 8e3d9c41-bed5-49a9-be4b-03939b791c46 185acf8d-5189-470c-b815-1356e2e6bb9d 73c776f6-90f6-444c-921a-7d5e1b859c19 f3b7434f-3642-427a-b366-0cac0dccad6e f0e7c98a-c982-4e9f-b4ea-340bd4203ef7 937c2d6a-483c-4295-a6ca-a17e8aca0272 a7e10dcd-d534-4c65-be58-e815dacba404"
 version "2"
}
}
handoff = component "Conversation handoff and source reads" {
metadata {
 harness_id "524fe9e6-d7d6-4df5-a4b7-df4e8ed02d01"
 brief "Official serialization hands effective source context and business facts to a fresh successor without an extra model request. Successors extend the effective context from a recognized seed and attach one current business appendix. At the compaction trigger the appendix preserves the latest Turn in full and retains statuses and attachment or artifact references for earlier Turns. Tool display records and UI activity are omitted. Recognized imported handoff seeds are repaired with official context edits while originals remain auditable. Scoped history tools read original conversation segments; Work readers remain task-scoped. Native journals retain separate engine identities. Forks use the selected result marker or a journal cutoff and retain bounded business history for older turns without private boundaries."
 source "fact"
 status "verified"
 evidence "a0716920-6118-49e9-94e7-b392a0d5bf22 a9d13166-0f67-431a-b09a-349b39d31b2c 90a83f7c-9a38-475a-a9ec-49d540abde2d 44b4de62-537a-42f1-8a5c-40d72900430b c9ce1bb9-aaae-401e-a985-df567fcd7d68 c3e52a0c-1863-4047-bbe1-7f301d53d301 e1ca99c3-c87f-4f8b-be6a-5704c282e37b"
 version "3"
}
}
}
}
}
shared = component "Shared contracts" {
metadata {
 harness_id "523ea4b5-9b46-4d67-be22-b9ee3d7d3cfb"
 brief "Shared contracts carry safe conversation activity, scoped child/cursor metadata and static Pi extension IDs. Current restoration filters removed IDs without granting replacements; application and HTTP validate new requests. Shared tool policy keeps browser operations opt-in across UI and runtime; shared name classification lets the editor group browser operations while execution still checks individual saved tool names. Existing JSON snapshots and global Work enums need no migration. Conversation title editing shares an 80-character bound and uses the existing conversation summary contract. Conversation live updates carry the updated turn and can include the related recovery source and context without title, private session or raw model payload. Paired normal conversation commands use a versioned closed allowlist with bounded payloads and static extension validation. Optional v2 learning metadata projects pause causes, retry and sample readiness without private evidence or model traces. A Workbench Agent message page contains entries and an optional cursor. The full transcript response also carries its Agent card. Question DTOs separate scoped identity/version, options, absolute deadline, answer provenance and delivery; conversation waitingForUser and goal queues are optional projections. The questions.v1 command extension validates bounded answers and exposes explicit conversation recovery without widening local permissions."
 source "fact"
 status "verified"
 evidence "67786627-f77c-4800-9ac6-386b484e5f5d b4fa28c9-1351-4ac0-aa75-af6c6f4e48a9 24499f6b-3dfd-4a50-836f-0a7b169c1ee2 c3ae40e3-2672-4b92-b011-b2ef3c6044a8 2a3aff22-8581-424c-af0a-c4182b77742f eeed5019-b62d-454f-9699-f461331a8fde dae47d44-3fd5-44e4-8c84-b7b383b49b7c 66be0606-2df5-4ca3-81ea-40fbf6a62599"
 version "16"
}
}
