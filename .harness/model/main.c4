questionStorage = component "Question queue and goal gate persistence" {
metadata {
 harness_id "5f7d481e-4aa4-4d17-9214-bd764bb92b21"
 brief "SQLite persists per-scope FIFO and one pending ACTIVE row. Answers match version, status, delivery and host deadline inside the write transaction. Parent-turn ownership is bound from durable child records; question changes advance payload-free conversation cursors in the same transaction. Authoritative Work pause, structured question and goal execution gate commit together. Exact action/run identity rejects stale producers; independent confirmations supersede or defer ordinary questions without timeout consent. Applying saved answers preserves provenance, resolves each Work action and creates one aggregate versioned recovery review only after the queue empties. Legacy question import preserves gate identities. Canceling individual Work withdraws its undelivered card and action, advances the next card or creates a versioned review without attributing an answer to the user. Goal resume revalidates queue and gate. Home projection retains every pending card and the latest 24 receipts."
 source "fact"
 status "verified"
 evidence "0d515d65-76c2-4bd3-a07e-387e7aae2a5b 27f6f8a9-0e50-4eb9-a032-c2cdbc45ad06 d63ccbcf-db94-4ecf-9116-1103243f699c 15cb1f9c-3615-409d-aafe-698cb987748b ad855662-5582-4472-b20f-134424607787 d3dd9f2d-2af5-4055-87b2-351646746121 bb2f305f-a3a8-48f8-8374-aa0117dcad93 5cc8dd07-5b08-4c9e-a9da-fc71b178abaa"
 version "1"
}
}
conversationStorage = component "Conversation persistence" {
metadata {
 harness_id "882f7b90-4074-4541-bcad-2c7a7ea4b7cb"
 brief "SQLite owns business conversations, ordered engine execution segments, stable turn bindings and safe projections. RUNNING ownership and predecessor CAS protect handoffs. Legacy private rows remain audit sources; Pi files own canonical history. Shared histories expose Pi thinking lifecycle and timing. Metadata-only rename, tombstones, child intents and public cursors retain their boundaries. Fork provenance and initial private seeds are durable; turn-to-segment bindings retain message cutoffs. Question projections join by durable parentTurnId, preserve historical pages and expose waiting separately from turn status. Recovery context and the source turn are private durable submission data. The linked recovery result and source answer receipts settle in one transaction."
 source "fact"
 status "verified"
 evidence "0d515d65-76c2-4bd3-a07e-387e7aae2a5b db8263f3-5e65-499b-b358-e54b40a000cd 1519c446-98f9-4b5a-b873-26ea5d8e7d89 c3ae40e3-2672-4b92-b011-b2ef3c6044a8 ac69fa43-cea7-401a-a580-5f894151a348 12189162-690a-45b7-9b0a-4d57e8601c4f 9080ee60-48a4-4e8f-a9ce-246c128136cf fc424fcd-e96b-4dde-b4a4-589153a6d74a d63ccbcf-db94-4ecf-9116-1103243f699c"
 version "9"
}
piSessions = component "Pi context and execution" {
metadata {
 harness_id "c12f9eba-5f56-4fa1-b864-025e3193a7c3"
 brief "Pinned official Pi sessions own execution, resources, retry and compaction. Joi keeps business admission, result settlement and scoped conversation lineage. Native facts and numeric observations are separate responsibilities. Pi thinking phases project lifecycle and timing. Only explicitly public provider summaries populate the shared summary DTO. SDK 1.5.2 stays locked; synthetic verification and package checks do not claim live-model convergence. Official sequential question extensions and RPC basic UI await the host-owned durable queue; SDK still owns same-turn execution and canonical tool results, while Joi owns deadlines, safe cards and delivery reconciliation."
